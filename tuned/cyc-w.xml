<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <Tracing>
      <Verbosity>config</Verbosity>
      <OutputFile>/tmp/cdds.log</OutputFile>
    </Tracing>
    <Internal>
      <NackDelay>1ms</NackDelay>
      <Watermarks>
        <WhcHigh>4MB</WhcHigh>
        <WhcHighInit>4MB</WhcHighInit>
      </Watermarks>
    </Internal>
  </Domain>
</CycloneDDS>
